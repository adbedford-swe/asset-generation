{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/adbedford-swe/asset-generation/main/schema/scene-spec.schema.json",
  "title": "assetgen scene spec",
  "description": "What `assetgen scene build` makes: a ground and the kinds of object on it, each generated once and placed or scattered as often as needed.",
  "type": "object",
  "required": ["objects"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"},
    "style": {"type": "string", "description": "Added to every prompt so the objects share a look."},
    "seed": {"type": "integer"},
    "harmonize": {"type": "number", "minimum": 0, "maximum": 1,
                  "description": "How far to match the objects' lighting and saturation (default 0.5)."},
    "concept": {"type": "string", "description": "A picture of the whole scene: the colour reference."},
    "ground": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {"oneOf": [{"type": "number"}, {"$ref": "#/$defs/vec2"}], "description": "[width, depth] in metres."},
        "prompt": {"type": "string", "description": "The surface, drawn as a tileable texture."},
        "texture": {"type": "string", "description": "Or a picture of the surface."},
        "color": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
        "tile": {"type": "number", "exclusiveMinimum": 0},
        "relief": {"type": "number", "minimum": 0, "description": "Height of hills, metres."},
        "feature": {"type": "number", "exclusiveMinimum": 0, "description": "Size of hills, metres."},
        "resolution": {"type": "number", "exclusiveMinimum": 0},
        "flatten": {"type": "number", "minimum": 0}
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "height"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
          "height": {"type": "number", "exclusiveMinimum": 0, "description": "Real height in metres."},
          "prompt": {"type": "string", "description": "The object on its own: what it is, its shape and material."},
          "image": {"type": "string"},
          "ply": {"type": "string"},
          "reference": {"type": "string"},
          "asset": {"type": "string", "description": "A finished prop: its .glb, .assetgen or run folder."},
          "kind": {"enum": ["prop", "diorama"]},
          "redraw": {"type": "number", "minimum": 0, "maximum": 1},
          "style": {"type": "boolean"},
          "collider": {"enum": ["auto", "convex", "box", "mesh", "none"]},
          "seed": {"type": "integer"},
          "place": {"type": "array", "items": {"$ref": "#/$defs/placement"}},
          "scatter": {"$ref": "#/$defs/scatter"}
        }
      }
    }
  },
  "$defs": {
    "vec2": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "yaw": {"oneOf": [{"type": "number"}, {"const": "random"},
                      {"type": "object", "required": ["face"], "additionalProperties": false,
                       "properties": {"face": {"oneOf": [{"type": "string"}, {"$ref": "#/$defs/vec2"}]}}}]},
    "placement": {
      "oneOf": [
        {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 3},
        {"type": "object", "required": ["position"], "additionalProperties": false,
         "properties": {"position": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 3},
                        "yaw": {"$ref": "#/$defs/yaw"}, "scale": {"type": "number", "exclusiveMinimum": 0},
                        "tilt": {"type": "boolean"}}}
      ]
    },
    "scatter": {
      "type": "object",
      "required": ["count"],
      "additionalProperties": false,
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "region": {"oneOf": [{"enum": ["all", "edge", "centre", "center"]},
                             {"type": "array", "items": {"$ref": "#/$defs/vec2"}, "minItems": 2, "maxItems": 2}]},
        "spacing": {"type": "number", "exclusiveMinimum": 0},
        "scale": {"oneOf": [{"type": "number"}, {"$ref": "#/$defs/vec2"}]},
        "yaw": {"$ref": "#/$defs/yaw"},
        "tilt": {"type": "boolean"},
        "clearance": {"type": "number", "minimum": 0}
      }
    }
  }
}
